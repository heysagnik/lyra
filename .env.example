# Neon Postgres connection string
DATABASE_URL="postgres://neondb_owner:password@ep-sample-123456.us-east-2.aws.neon.tech/neondb?sslmode=require"

# Better Auth secret and URL
BETTER_AUTH_SECRET="development-secret-must-be-at-least-32-chars-long"
BETTER_AUTH_URL="http://localhost:3000"

# Google OAuth (Optional in dev)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# InferKit (LLM provider)
INFERKIT_API_KEY="ik_sample_inferkit_key"

# TinyFish TinySearch
TINYFISH_API_KEY="tf_sample_tinyfish_key"

# Client-facing URL
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Secret Vercel sends to cron routes (Authorization: Bearer ...). Set the same value in Vercel env vars.
CRON_SECRET="change-me-to-a-long-random-string"
