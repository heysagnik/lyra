# Neon Postgres connection string
DATABASE_URL="postgres://neondb_owner:password@ep-sample-123456.us-east-2.aws.neon.tech/neondb?sslmode=require"

# Better Auth secret and URL
BETTER_AUTH_SECRET="development-secret-must-be-at-least-32-chars-long"
BETTER_AUTH_URL="http://localhost:3000"

# Google OAuth (Optional in dev)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Groq API
GROQ_API_KEY="gsk_sample_groq_api_key"
GROQ_MODEL_PRIMARY="qwen/qwen3.8-27b"
GROQ_MODEL_FALLBACK="openai/gpt-oss-20b"

# TinyFish TinySearch
TINYFISH_API_KEY="tf_sample_tinyfish_key"

# Upstash Redis
UPSTASH_REDIS_REST_URL="https://sample-redis.upstash.io"
UPSTASH_REDIS_REST_TOKEN="sample_redis_token"

# Upstash QStash
QSTASH_TOKEN="sample_qstash_token"
QSTASH_CURRENT_SIGNING_KEY="sample_qstash_current_signing_key"
QSTASH_NEXT_SIGNING_KEY="sample_qstash_next_signing_key"

# Worker route shared secret
WORKER_SECRET="development-worker-secret-at-least-16-chars"

# Client-facing URL
NEXT_PUBLIC_APP_URL="http://localhost:3000"
